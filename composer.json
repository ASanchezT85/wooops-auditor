{
  "name": "wooops/auditor",
  "description": "WooOps Auditor v0.1 - read-only WooCommerce operational diagnostics",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=8.1"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5"
  },
  "autoload": {
    "psr-4": {
      "WooOps\\Auditor\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "WooOps\\Auditor\\Tests\\": "tests/"
    }
  },
  "config": {
    "sort-packages": true
  },
  "scripts": {
    "test": "phpunit",
    "sample": "php bin/generate-sample.php"
  }
}
